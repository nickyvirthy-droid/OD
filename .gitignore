# Virtual Environment
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/*.log
logs/*.jsonl

# Backups (keep structure, ignore content)
backups/*.bak
backups/*.tar.gz

# Archives (keep structure, ignore content)
archive/*.txt

# Runtime
runtime/control_bridge/*.pyc

# Memory (sensitive data)
memory/*.db
memory/*.json

# Imports (quarantine zone)
imports/*

# Test coverage
htmlcov/
.coverage
.coverage.*
coverage.xml

# Pytest
.pytest_cache/

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Environment variables
.env
.env.local
.env.*.local

# Secrets (real credentials stay local; commit only .example templates)
config/iot_credentials.json
config/*_credentials.json

# Runtime state (conversations, caches)
data/

# Docker
docker-compose.override.yml

# Workspaces (OpenClaw agent environments)
workspace/

# Node (if used for tools)
node_modules/

# Temporary files
*.tmp
*.temp
*.log

# Voice binaries
voice/
.aider*

# APKs publicados na landing e backups de APK (binários grandes — não versionar;
# o APK oficial é republicado em site/ pelo app/build_apk.sh)
site/*.apk
backups/apk-*/

# Backups automáticos do self-repair (.bak gerados pelo Coder Engine)
.od_repair_backups/

# Credenciais Firebase — NUNCA versionar (ver docs/FIREBASE_SETUP.md).
# O padrão sem barra vale para qualquer diretório (ex: 000/google-services.json).
google-services.json
*firebase-adminsdk*.json
service-account*.json
firebase-service-account*.json

# 000/ — pasta de trabalho local do projeto (notas de construção, ideias,
# rascunhos e material do usuário; inclui 000/google-services.json).
# Conteúdo pessoal, não parte do sistema: não versionar.
000/

# Trabalho local na raiz do servidor: scripts de apoio, rascunhos e saída de
# build do Flutter. Não é o sistema e não deve ir para o repositório.
# Ancorado na raiz para não capturar homônimos dentro do código.
/agent.py
/agent.b64
/txt.txt
/GPT_preview.png
/executar.sh
/gemini_prompt.sh
/llama_prompt.sh
/od_aider.sh
/od_prompt.sh
/sandbox_agent/
/assets/
